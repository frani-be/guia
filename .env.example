# Base de la clave. La clave final de cada persona es BASE_PASSWORD + su_usuario_ig
# Usa minúsculas y sin espacios. Ej: si la base es "lila2024" y el usuario es "frani.be",
# la clave de esa persona es "lila2024frani.be"
BASE_PASSWORD=tu_base_aqui

# URL del Web App de Google Apps Script que registra los accesos
# (ver apps_script.gs y README.md para cómo desplegarlo)
LOG_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec
