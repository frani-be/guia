# Base de la clave. Cada persona entra con BASE_PASSWORD + su_usuario_ig
# Ej: si la base es "lila2024" y su usuario es "frani.be", su clave es "lila2024frani.be"
# Solo minúsculas, sin espacios ni símbolos raros (mínimo 6 caracteres)
BASE_PASSWORD=tu_base_aqui

# URL del Web App de Google Apps Script que registra los accesos
# (ver apps_script.gs y README.md para cómo desplegarlo)
LOG_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec
